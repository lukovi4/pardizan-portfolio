---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('legal');
  // slug из frontmatter = точный URL, включая подчёркивания (terms_conditions).
  return entries.map((entry) => ({
    params: { legal: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{/*
  Отдельная страница с текстом: ни шапки, ни меню, ни подвала.
  Единственная ссылка на сайт — логотип сверху.
*/}
<Base title={entry.data.title} noindex>
  <main class="legal">
    <a class="mark" href={`${base}/`}>Evgeny Lukovich</a>
    <article>
      <Content />
    </article>
  </main>
</Base>

<style>
  .legal {
    /* 800px — ширина страницы вместе с боковыми полями */
    max-width: 50rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 3rem) var(--gutter) clamp(4rem, 10vw, 6rem);
  }

  /* Единственный элемент навигации на странице — знак сайта */
  .mark {
    display: inline-block;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .mark:hover {
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  article {
    margin-top: clamp(2rem, 6vw, 3rem);
    color: #222;
    line-height: 1.7;
  }

  /* ---------- Заголовки ---------- */
  /* Название документа */
  article :global(h1) {
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Строка «Last updated» сразу под названием */
  article :global(h1 + p) {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  article :global(h1 + p strong) {
    font-weight: 400;
  }

  /* Нумерованный раздел: отбивается линией, как секции на сайте */
  article :global(h2) {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.015em;
    color: #222;
  }

  article :global(h3) {
    margin-top: 1.75rem;
    font-weight: 600;
    font-size: 16px;
    color: #222;
  }

  article :global(h2 + p),
  article :global(h3 + p),
  article :global(h2 + ul),
  article :global(h3 + ul) {
    margin-top: 0.8rem;
  }

  /* ---------- Текст ---------- */
  article :global(p),
  article :global(ul),
  article :global(ol) {
    margin-bottom: 1.1rem;
  }

  article :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  /* ---------- Списки ---------- */
  article :global(ul),
  article :global(ol) {
    padding-left: 0;
    list-style: none;
  }

  article :global(li) {
    position: relative;
    padding-left: 1.6rem;
  }

  article :global(li + li) {
    margin-top: 0.3rem;
  }

  /* Маркер — тире, как в списках на главной */
  article :global(ul > li)::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  /* Нумерация — своим счётчиком, цифра стоит в том же поле, что и тире */
  article :global(ol) {
    counter-reset: step;
  }

  article :global(ol > li) {
    counter-increment: step;
  }

  article :global(ol > li)::before {
    content: counter(step) '.';
    position: absolute;
    left: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  article :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  article :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2rem 0;
  }
</style>
