---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { project: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, name, slug, tagline, roles, cover, coverAlt } = project.data;

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home/home.md не найден');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`${name} — Evgeny Lukovich`} description={tagline}>
  <Header />

  <main class="case shell">
    <a class="back cap" href={`${base}/#work`}>← All work</a>
    <p class="cap roles">{roles.join(' · ')}</p>
    <h1>{title}</h1>
    <div class="cover" transition:name={`cover-${slug}`}>
      <Image src={cover} alt={coverAlt} widths={[720, 1080, 1600]} sizes="92vw" loading="eager" />
    </div>
    <div class="soon" data-reveal>
      <p class="cap">Case study</p>
      <p class="note">
        The full case study is being rebuilt for the new site. Meanwhile — <a
          href={`mailto:${home.data.links.email}`}>drop me a line</a
        > and I'll walk you through the project.
      </p>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .case {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3.5rem, 9vw, 6rem);
  }

  .back {
    display: inline-block;
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  .roles {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  h1 {
    margin-top: 0.8rem;
    font-weight: 600;
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 24ch;
  }

  .cover {
    margin-top: clamp(2rem, 5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: #f2f0e9;
  }

  .soon {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .note {
    margin-top: 0.5rem;
    max-width: 48ch;
    color: var(--muted);
  }

  .note a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
