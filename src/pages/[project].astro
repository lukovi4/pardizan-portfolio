---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBar from '../components/StatusBar.astro';
import ScreenSlider from '../components/ScreenSlider.astro';
import Lightbox from '../components/Lightbox.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, i) => ({
    params: { project: project.data.slug },
    // Кольцевой переход: с последнего кейса возвращаемся к первому
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;

// Переход к следующему кейсу спрятан. Разметка и данные на месте:
// чтобы вернуть, достаточно поставить true.
const showNextCase = false;
const { title, name, tagline, roles, summary, lead, years, role, links, sections = [] } =
  project.data;

// Поля кейса: подпись слева, значение справа — как в карточке на главной
const fields = [
  years && { label: 'Years', value: years },
  role && { label: 'Role', value: role },
  roles?.length && { label: 'Scope', value: roles.join(', ') },
].filter(Boolean) as { label: string; value: string }[];

// Раскладка ряда определяется ориентацией первого скрина: мобильные экраны
// вертикальные — три в ряд, веб горизонтальный — один на всю ширину.
const isWide = (screens?: { src: ImageMetadata }[]) =>
  !!screens?.length && screens[0].src.width > screens[0].src.height;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`${name} — Evgeny Lukovich`} description={tagline} paged>
  <Header active="work" />
  <StatusBar />

  <main class="scroller case-page">
    <section class="head screen shell">
      <h1>{title}</h1>
      {(lead ?? summary) && <p class="lead">{lead ?? summary}</p>}

      <dl class="fields">
        {
          fields.map((field) => (
            <div class="field">
              <dt>{field.label}</dt>
              <dd>{field.value}</dd>
            </div>
          ))
        }
        {
          links && links.length > 0 && (
            <div class="field">
              <dt>Media</dt>
              <dd class="links">
                {links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </section>

    {/* Описание длиннее экрана — прокручивается целиком, как Experience */}
    <div class="chapters screen">
      {
        sections.map((section) => (
        <section class="chapter">
          <div class="shell chapter-head">
            <h2>{section.title}</h2>
            <div class="chapter-body">
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.note && <p class="note">{section.note}</p>}
            </div>
          </div>

          {section.screens && section.screens.length > 0 && isWide(section.screens) && (
            <ScreenSlider screens={section.screens} />
          )}

          {section.screens && section.screens.length > 0 && !isWide(section.screens) && (
            <ul class="shots" data-gallery>
              {section.screens.map((screen) => (
                <li>
                  <Image
                    src={screen.src}
                    alt={screen.alt}
                    widths={[300, 600, 900]}
                    sizes="(max-width: 36rem) 92vw, (max-width: 56rem) 46vw, (max-width: 64rem) 340px, 302px"
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

      {
        showNextCase && (
          <nav class="shell next" aria-label="Next case">
            <span class="cap">Next case</span>
            <a href={`${base}/${next.data.slug}`}>
              {next.data.name} <span aria-hidden="true">→</span>
            </a>
          </nav>
        )
      }
    </div>

    <Footer />
  </main>

  <Lightbox />
</Base>

<style>
  /* Первый экран и контакты примагничиваются, описание между ними
     прокручивается свободно: у .screen высота не меньше экрана, но секция
     выше экрана просто растёт — привязка срабатывает на её границе. */

  /* Первый раздел описания уже отбит полем экрана */
  .chapters > .chapter:first-child {
    margin-top: 0;
  }

  /* Заголовок и описание — один в один с hero на главной: тот же кегль,
     межстрочный, трекинг, мера и разрыв между ними. */
  h1 {
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    /* pretty, а не balance: balance делит строки поровну и рвёт короткий
       заголовок надвое — та же причина, что в hero */
    text-wrap: pretty;
  }

  .lead {
    margin-top: clamp(1.5rem, 3.5vw, 2.5rem);
    max-width: 800px;
    font-size: 18px;
    color: var(--ink);
  }

  /* Поля кейса: слева подпись, справа значение, строки разделены линиями */
  .fields {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    max-width: 34rem;
  }

  .field {
    display: grid;
    grid-template-columns: minmax(0, 6rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
  }

  .field:last-child {
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: 0.85rem;
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: 0.9rem;
    color: #222;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .links a:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }

  /* ---------- Разделы кейса ---------- */
  .chapter {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  /* Та же сетка, что у Experience: заголовок слева, текст справа */
  .chapter-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 0.5rem 2rem;
    align-items: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .chapter h2 {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.015em;
    color: #222;
  }

  .chapter-body p {
    font-weight: 400;
    font-size: 16px;
    color: #222;
    max-width: 46rem;
  }

  .chapter-body p + p {
    margin-top: 0.9rem;
  }

  .note {
    margin-top: 1.25rem;
    font-size: 14px;
    color: var(--muted);
  }

  /* ---------- Скрины: ряды по четыре, у веба — один на ряд ---------- */
  /* Шире колонки текста: она остаётся 72rem, скрины идут до 1280px.
     На узком экране потолок сам опускается до окна за вычетом полей. */
  .shots {
    max-width: min(1280px, 100% - 2 * var(--gutter));
    margin-inline: auto;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    /* Список: гасим собственный отступ браузера, раньше это делал .shell */
    padding: 0;
    list-style: none;
  }

  .shots.wide {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Скрин ограничен и по ширине, и по высоте: он всегда должен помещаться
     в экран целиком, как работы на главной. Высота считается так же —
     окно минус шапка, нижняя полоса и поля. Если ограничила высота, скрин
     становится уже колонки, поэтому центрируем. */
  .shots :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 2 * var(--header-h) - 2 * var(--panel-pad));
    justify-self: center;
    border-radius: 14px;
    background: var(--surface);
  }

  @media (max-width: 64rem) {
    .shots {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 56rem) {
    .chapter-head {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 36rem) {
    .shots {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Следующий кейс ---------- */
  .next {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .next a {
    font-weight: 600;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    letter-spacing: -0.025em;
    text-decoration: none;
    width: fit-content;
  }

  .next a:hover {
    color: var(--accent-ink);
  }
</style>
