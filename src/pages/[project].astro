---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBar from '../components/StatusBar.astro';
import ScreenSlider from '../components/ScreenSlider.astro';
import Lightbox from '../components/Lightbox.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, i) => ({
    params: { project: project.data.slug },
    // Кольцевой переход: с последнего кейса возвращаемся к первому
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;

// Переход к следующему кейсу спрятан. Разметка и данные на месте:
// чтобы вернуть, достаточно поставить true.
const showNextCase = false;
const { title, name, tagline, roles, summary, lead, years, role, links, sections = [] } =
  project.data;

// Поля кейса: подпись слева, значение справа — как в карточке на главной
const fields = [
  years && { label: 'Years', value: years },
  role && { label: 'Role', value: role },
  roles?.length && { label: 'Scope', value: roles.join(', ') },
].filter(Boolean) as { label: string; value: string }[];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Подряд идущие разделы с одинаковым заголовком — это один раздел: слева
// заголовок печатается один раз, справа блоки идут друг за другом.
// Так «Key decisions» перестаёт повторяться на каждый подзаголовок.
// Часть со скринами склейку обрывает: иначе слайдер уехал бы из-под своего
// текста в конец раздела.
type Section = (typeof sections)[number];
const groups: { title?: string; parts: Section[] }[] = [];

for (const section of sections) {
  const group = groups.at(-1);
  const open = group && !group.parts.at(-1)?.screens?.length;

  if (open && section.title && section.title === group.title) group.parts.push(section);
  else groups.push({ title: section.title, parts: [section] });
}
---

<Base title={`${name} — Evgeny Lukovich`} description={tagline} paged>
  <Header active="work" />
  <StatusBar />

  <main class="scroller case-page">
    <section class="head screen shell">
      <h1>{title}</h1>
      {(lead ?? summary) && <p class="lead">{lead ?? summary}</p>}

      <dl class="fields">
        {
          fields.map((field) => (
            <div class="field">
              <dt>{field.label}</dt>
              <dd>{field.value}</dd>
            </div>
          ))
        }
        {
          links && links.length > 0 && (
            <div class="field">
              <dt>Media</dt>
              <dd class="links">
                {links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </section>

    {/* Описание длиннее экрана — прокручивается целиком, как Experience */}
    <div class="chapters screen">
      {
        groups.map((group) => (
        <section class="chapter">
          {group.parts.some((part) => part.title || part.heading || part.body.length > 0) && (
            <div class="shell chapter-head">
              <h2>{group.title}</h2>
              <div class="chapter-body">
                {group.parts.map((part) => (
                  <div class="part">
                    {part.heading && <h3>{part.heading}</h3>}
                    {part.body.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                    {part.note && <p class="note">{part.note}</p>}
                  </div>
                ))}
              </div>
            </div>
          )}

          {group.parts.at(-1)?.screens?.length > 0 && (
            <ScreenSlider screens={group.parts.at(-1).screens} />
          )}
        </section>
      ))
    }

      {
        showNextCase && (
          <nav class="shell next" aria-label="Next case">
            <span class="cap">Next case</span>
            <a href={`${base}/${next.data.slug}`}>
              {next.data.name} <span aria-hidden="true">→</span>
            </a>
          </nav>
        )
      }
    </div>

    <Footer />
  </main>

  <Lightbox />
</Base>

<style>
  /* Первый экран и контакты примагничиваются, описание между ними
     прокручивается свободно: у .screen высота не меньше экрана, но секция
     выше экрана просто растёт — привязка срабатывает на её границе. */

  /* Первый раздел описания уже отбит полем экрана */
  .chapters > .chapter:first-child {
    margin-top: 0;
  }

  /* Заголовок и описание — один в один с hero на главной: тот же кегль,
     межстрочный, трекинг, мера и разрыв между ними. */
  h1 {
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    /* pretty, а не balance: balance делит строки поровну и рвёт короткий
       заголовок надвое — та же причина, что в hero */
    text-wrap: pretty;
  }

  .lead {
    margin-top: clamp(1.5rem, 3.5vw, 2.5rem);
    max-width: 800px;
    font-size: 18px;
    color: var(--ink);
  }

  /* Поля кейса: слева подпись, справа значение, строки разделены линиями */
  .fields {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    max-width: 34rem;
  }

  .field {
    display: grid;
    grid-template-columns: minmax(0, 6rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
  }

  dt {
    font-size: 0.85rem;
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: 0.9rem;
    color: #222;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .links a:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }

  /* ---------- Разделы кейса ---------- */
  .chapter {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  /* Заголовок слева, текст справа. Пропорция подобрана так, чтобы текстовая
     колонка дотягивала до 800px — той же меры, что в hero и About. */
  .chapter-head {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 7fr);
    gap: 0.5rem 2rem;
    align-items: start;
    padding-top: 1.25rem;
  }

  .chapter h2 {
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    /* Прописные требуют разрядки: с прежним отрицательным трекингом
       буквы слипались бы. */
    letter-spacing: 0.04em;
    color: #222;
  }

  /* Блоки одного раздела отбиты друг от друга сильнее, чем абзацы внутри
     блока: иначе подзаголовок липнет к предыдущему тексту. */
  .chapter-body .part + .part {
    margin-top: 1.75rem;
  }

  .chapter-body h3 {
    margin-bottom: 0.9rem;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: #222;
  }

  .chapter-body p {
    font-weight: 400;
    font-size: 18px;
    color: #222;
    max-width: 800px;
  }

  .chapter-body p + p {
    margin-top: 0.9rem;
  }

  .note {
    margin-top: 1.25rem;
    font-size: 14px;
    color: var(--muted);
  }

  /* ---------- Скрины: ряды по четыре, у веба — один на ряд ---------- */
  /* Шире колонки текста: она остаётся 72rem, скрины идут до 1280px.
     На узком экране потолок сам опускается до окна за вычетом полей. */
  /* ---------- Следующий кейс ---------- */
  .next {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .next a {
    font-weight: 600;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    letter-spacing: -0.025em;
    text-decoration: none;
    width: fit-content;
  }

  .next a:hover {
    color: var(--accent-ink);
  }
</style>
