---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBar from '../components/StatusBar.astro';
import Lightbox from '../components/Lightbox.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home/home.md не найден');
const { Content: About } = await render(home);

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const { headline, intro, companies, principles, experience } = home.data;

// Карточки принципов спрятаны. Данные и разметка на месте: чтобы вернуть,
// достаточно поставить true.
const showPrinciples = false;

// Названия компаний внутри intro подставляем ссылками: сам текст остаётся
// одним предложением в контенте и правится как обычный текст.
const escapeForRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const companyPattern = new RegExp(`(${companies.map((c) => escapeForRegExp(c.name)).join('|')})`, 'g');
const introParts = intro
  .split(companyPattern)
  .filter(Boolean)
  .map((part) => ({ text: part, url: companies.find((c) => c.name === part)?.url }));

// Финальный знак последнего предложения — красным: «…for both[.]»
const headLines = headline.map((line, i) => {
  if (i < headline.length - 1) return { text: line, mark: '' };
  const punct = line.match(/^(.*?)([.?!])$/);
  return punct ? { text: punct[1], mark: punct[2] } : { text: line, mark: '' };
});

const workRange = `01–${String(projects.length).padStart(2, '0')}`;

// Старая сетка карточек скрыта: её заменили кейсы с лентами скринов.
// Вернуть — поставить true.
const showWorkGrid = false;

// Блок с лентой скринов показываем только у кейсов, где скрины уже подготовлены.
const cases = projects.filter((project) => project.data.screens?.length);
---

<Base
  title="Evgeny Lukovich — Product Designer"
  description="Senior product designer with 10+ years across Vimeo, NerdWallet, AppLovin, and DeoVR — growth, monetization, onboarding, and complex product systems."
  paged
>
  <Header />
  <StatusBar />

  {/* Неподвижная подложка под работами: цвет берётся у активного кейса */}
  <div class="backdrop" data-backdrop-layer aria-hidden="true"></div>
  {/* Постоянная рамка страницы: белая заливка снаружи обрезает всё,
      что выехало за её края при прокрутке */}
  <div class="frame" aria-hidden="true"></div>

  <main class="scroller">
    <section id="hero" class="hero screen shell">
      <div class="hero-grid">
        <h1>
          {
            headLines.map(({ text, mark }) => (
              <span class="line">
                {text}
                {mark && <span class="mark">{mark}</span>}
              </span>
            ))
          }
        </h1>
        <p class="sub">
          {
            introParts.map((part) =>
              part.url ? (
                <a href={part.url} target="_blank" rel="noopener">
                  {part.text}
                </a>
              ) : (
                part.text
              ),
            )
          }
        </p>
      </div>
    </section>

    {
      showWorkGrid && (
        <section id="work" class="work shell">
          <div class="section-head">
            <h2>Selected work</h2>
            <span class="cap">{workRange}</span>
          </div>
          <div class="grid">
            {projects.map((project, i) => (
              <ProjectCard project={project} index={i} />
            ))}
          </div>
        </section>
      )
    }

    {cases.map((project, i) => <ProjectShowcase project={project} anchor={i === 0 ? 'cases' : undefined} />)}

    <section id="experience" class="experience screen shell">
      <ol>
        {
          experience.map((e) => (
            <li>
              <div class="post">
                <h3>{e.role}</h3>
                {e.company && <p class="company">{e.company}</p>}
                <p class="period cap">{e.period}</p>
              </div>
              <ul class="points">
                {e.description.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="about" class="about screen shell">
      <div class="about-grid" data-reveal>
        <div class="bio">
          <About />
        </div>
        {
          showPrinciples && (
            <ol class="principles">
              {principles.map((p) => (
                <li class="principle">
                  <h3>{p.title}</h3>
                  <p>{p.description}</p>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </section>
    <Footer />
  </main>

  <Lightbox />

</Base>

<style>
  /* ---------- Подложка под работами ---------- */
  /* Окно страницы: весь контент живёт внутри него и обрезается его краями.
     Сверху вплотную к шапке, снизу такое же поле, по бокам --panel-inset. */
  .backdrop,
  .frame {
    position: fixed;
    top: var(--header-h);
    bottom: var(--header-h);
    left: var(--panel-inset);
    right: var(--panel-inset);
    border-radius: var(--panel-radius);
    pointer-events: none;
  }

  /* Цвет окна — под контентом. Появляется только под работой. */
  .backdrop {
    z-index: 0;
    background: var(--backdrop-color, transparent);
    opacity: 0;
    transition:
      background-color 0.5s ease,
      opacity 0.45s ease;
  }

  .backdrop.is-on {
    opacity: 1;
  }

  /* Рамка — поверх контента: заливка наружу закрывает всё, что выехало за
     окно. Дырка в тени повторяет скругление, поэтому углы честные. */
  .frame {
    z-index: 5;
    box-shadow: 0 0 0 100vmax var(--paper);
  }

  /* Контент между цветом и рамкой */
  .scroller {
    position: relative;
    z-index: 1;
  }

  /* На мобильных постраничности нет — страница листается обычным потоком,
     неподвижное окно там только мешало бы. */
  @media (max-width: 56rem) {
    .backdrop,
    .frame {
      display: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(4rem, 11vw, 7.5rem) clamp(3rem, 8vw, 5.5rem);
  }

  /* Крестик, как в макетной сетке */
  .hero::before {
    content: '+';
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    opacity: 0.55;
  }

  /* Отсчёт от края окна, а не экрана — иначе рамка срезала бы крестики */
  .hero::before {
    top: calc(var(--header-h) + 1rem);
    right: var(--gutter);
  }

  /* Сверху утверждение, под ним описание */
  .hero-grid {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  h1 {
    font-weight: 600;
    /* Заголовок во всю ширину: кегль подобран так, чтобы самое длинное
       предложение помещалось в строку целиком. */
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* Предложение с новой строки; длинное переносится само. balance здесь
     нельзя: он делит поровну и короткое предложение рвётся надвое. */
  h1 .line {
    display: block;
    text-wrap: pretty;
  }

  .mark {
    color: var(--accent);
  }

  .sub {
    max-width: 800px;
    font-size: 18px;
    color: var(--ink);
  }

  /* Компании: тонкое серое подчёркивание, по наведению — фирменное жёлтое */
  .sub a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  .sub a:hover {
    text-decoration-color: var(--brand);
  }

  /* ---------- Заголовки секций ---------- */
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .section-head h2 {
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
  }

  /* Поля равны краю окна плюс воздух — иначе рамка срезала бы низ текста */
  .work,
  .experience,
  .about {
    padding-block: calc(var(--header-h) + 1rem);
  }

  /* Опыт длиннее экрана — и это нормально: спецификация требует игнорировать
     точки привязки, из-за которых контент стал бы недостижимым. Секция просто
     прокручивается целиком, а следующий экран примагничивается на её границе. */

  /* ---------- Work: ровная сетка в две колонки ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3.5vw, 2.5rem);
  }

  /* ---------- Experience ---------- */
  .experience > ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Подсветка при наведении выходит за текст на 20px со всех сторон: поле
     даёт запас, а отрицательные поля по горизонтали возвращают текст на
     место — колонки остаются на общей сетке страницы. */
  .experience > ol > li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 0.5rem 2rem;
    align-items: baseline;
    padding: 20px;
    margin-inline: -20px;
    border-radius: 14px;
    transition: background 0.2s ease;
  }

  .experience > ol > li:hover {
    background: color-mix(in srgb, var(--paper) 96%, var(--ink));
  }

  .experience h3 {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.015em;
    color: #222;
  }

  .experience .company {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .experience .period {
    margin-top: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  /* Пункты описания — буллетами, как в резюме. Маркер — тире. */
  .experience .points {
    margin: 0;
    padding-left: 0;
    max-width: 46rem;
    list-style: none;
  }

  .experience .points li {
    position: relative;
    padding-left: 1.4rem;
    font-weight: 400;
    font-size: 16px;
    color: #222;
  }

  /* Тире вынесено в поле, текст пункта выравнивается по одной линии */
  .experience .points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  .experience .points li + li {
    margin-top: 0.4rem;
  }

  /* ---------- About ---------- */
  /* Описание сверху, под ним четыре плитки в один ряд.
     Зазор сетки — это расстояние от текста до ряда карточек; между самими
     карточками свои 8px, они заданы в .principles. */
  .about-grid {
    display: grid;
    gap: 60px;
  }

  /* Плитки — то же оформление, что у карточки кейса на главной */
  .principle {
    background: var(--surface);
    border-radius: 14px;
  }

  /* Описание без подложки — текст висит на странице, как в hero.
     Поэтому и полей нет: строка начинается ровно от левого края первой
     плитки, иначе текст съезжал бы относительно ряда под ним.
     Абзацы во всю ширину, друг под другом. */
  .bio {
    padding: 0;
    max-width: 800px;
  }

  /* Все абзацы одинаковые: ни кегль, ни цвет не делят текст на главный
     и второстепенный. Между абзацами только отступ. */
  .bio :global(p) {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .bio :global(p + p) {
    margin-top: 1.1rem;
  }

  /* Четыре принципа в один ряд, колонки равной ширины */
  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .principle {
    padding: 24px;
  }

  .principle h3 {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  /* Текст в плитках мельче, чем описание сверху */
  .principle p {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* ---------- Адаптив ---------- */
  @media (max-width: 56rem) {
    /* Крестик стоит в углу окна, а на узком экране заголовок доходит до
       самого края и крестик ложится прямо на буквы — там он не нужен. */
    .hero::before {
      content: none;
    }

    .experience > ol > li {
      grid-template-columns: 1fr;
    }

    /* Четыре колонки в ряд становятся слишком узкими для текста — по две */
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .principles {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Активной считается работа, пересёкшая середину экрана: rootMargin сжимает
  // область наблюдения до линии по центру, поэтому активной всегда ровно одна.
  const setupBackdrop = () => {
    const layer = document.querySelector<HTMLElement>('[data-backdrop-layer]');
    if (!layer) return;

    const cases = document.querySelectorAll<HTMLElement>('.case[data-backdrop]');
    if (!cases.length) return;

    // На мобильных .scroller не прокручивается — там наблюдаем за окном.
    const scroller = document.querySelector('.scroller');
    const root =
      scroller instanceof HTMLElement && scroller.scrollHeight > scroller.clientHeight
        ? scroller
        : null;

    const active = new Set<HTMLElement>();

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting) active.add(target);
          else active.delete(target);
        }

        const current = [...active].pop();
        if (current) {
          layer.style.setProperty('--backdrop-color', current.dataset.backdrop || '');
          layer.classList.add('is-on');
        } else {
          layer.classList.remove('is-on');
        }
      },
      { root, rootMargin: '-50% 0px -50% 0px' },
    );

    cases.forEach((section) => io.observe(section));
  };

  setupBackdrop();
  document.addEventListener('astro:page-load', setupBackdrop);
</script>
