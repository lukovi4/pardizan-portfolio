---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home/home.md не найден');
const { Content: About } = await render(home);

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const { headline, intro, companies, strengths, facts, experience } = home.data;

// «Vimeo, NerdWallet, AppLovin, and DeoVR.» — с точкой в конце
const companyParts = companies.map((name, i) => ({
  name,
  sep: i === companies.length - 1 ? '.' : i === companies.length - 2 ? ', and ' : ', ',
}));

// Финальный знак заголовка — красным: «…who ships[.]»
const punct = headline.match(/^(.*?)([.?!])$/);
const headText = punct ? punct[1] : headline;
const headMark = punct ? punct[2] : '';

const workRange = `01–${String(projects.length).padStart(2, '0')}`;

// Старая сетка карточек скрыта: её заменили кейсы с лентами скринов.
// Вернуть — поставить true.
const showWorkGrid = false;

// Блок с лентой скринов показываем только у кейсов, где скрины уже подготовлены.
const cases = projects.filter((project) => project.data.screens?.length);
---

<Base
  title="Evgeny Lukovich — Product Designer"
  description="Senior product designer with 10+ years across Vimeo, NerdWallet, AppLovin, and DeoVR — growth, monetization, onboarding, and complex product systems."
  paged
>
  <Header />

  {/* Неподвижная подложка под работами: цвет берётся у активного кейса */}
  <div class="backdrop" data-backdrop-layer aria-hidden="true"></div>
  {/* Постоянная рамка страницы: белая заливка снаружи обрезает всё,
      что выехало за её края при прокрутке */}
  <div class="frame" aria-hidden="true"></div>

  <main class="scroller">
    <section id="hero" class="hero screen shell">
      <h1>{headText}<span class="mark">{headMark}</span></h1>
      <p class="sub">
        {intro}{' '}
        {companyParts.map(({ name, sep }) => <Fragment><strong>{name}</strong>{sep}</Fragment>)}
      </p>
    </section>

    {
      showWorkGrid && (
        <section id="work" class="work shell">
          <div class="section-head">
            <h2>Selected work</h2>
            <span class="cap">{workRange}</span>
          </div>
          <div class="grid">
            {projects.map((project, i) => (
              <ProjectCard project={project} index={i} />
            ))}
          </div>
        </section>
      )
    }

    {cases.map((project, i) => <ProjectShowcase project={project} anchor={i === 0 ? 'cases' : undefined} />)}

    <section id="strengths" class="strengths screen shell">
      <div class="section-head">
        <h2>Core strengths</h2>
        <span class="cap">01–{String(strengths.length).padStart(2, '0')}</span>
      </div>
      <ol>
        {
          strengths.map((s) => (
            <li data-reveal>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="experience" class="experience screen shell">
      <div class="section-head">
        <h2>Experience</h2>
        <span class="cap">01–{String(experience.length).padStart(2, '0')}</span>
      </div>
      <ol>
        {
          experience.map((e) => (
            <li>
              <div class="post">
                <h3>{e.role}</h3>
                {e.company && <p class="company">{e.company}</p>}
                <p class="period cap">{e.period}</p>
              </div>
              <ul class="points">
                {e.description.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="about" class="about screen shell">
      <div class="section-head">
        <h2>About</h2>
      </div>
      <div class="bio" data-reveal>
        <About />
        <dl class="facts">
          {
            facts.map((f) => (
              <div class="fact">
                <dt class="cap">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
    <Footer />
  </main>
</Base>

<style>
  /* ---------- Подложка под работами ---------- */
  /* Окно страницы: весь контент живёт внутри него и обрезается его краями.
     Сверху вплотную к шапке, снизу такое же поле, по бокам --panel-inset. */
  .backdrop,
  .frame {
    position: fixed;
    top: var(--header-h);
    bottom: var(--header-h);
    left: var(--panel-inset);
    right: var(--panel-inset);
    border-radius: var(--panel-radius);
    pointer-events: none;
  }

  /* Цвет окна — под контентом. Появляется только под работой. */
  .backdrop {
    z-index: 0;
    background: var(--backdrop-color, transparent);
    opacity: 0;
    transition:
      background-color 0.5s ease,
      opacity 0.45s ease;
  }

  .backdrop.is-on {
    opacity: 1;
  }

  /* Рамка — поверх контента: заливка наружу закрывает всё, что выехало за
     окно. Дырка в тени повторяет скругление, поэтому углы честные. */
  .frame {
    z-index: 5;
    box-shadow: 0 0 0 100vmax var(--paper);
  }

  /* Контент между цветом и рамкой */
  .scroller {
    position: relative;
    z-index: 1;
  }

  /* На мобильных постраничности нет — страница листается обычным потоком,
     неподвижное окно там только мешало бы. */
  @media (max-width: 56rem) {
    .backdrop,
    .frame {
      display: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(4rem, 11vw, 7.5rem) clamp(3rem, 8vw, 5.5rem);
  }

  /* Крестик, как в макетной сетке */
  .hero::before {
    content: '+';
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    opacity: 0.55;
  }

  /* Отсчёт от края окна, а не экрана — иначе рамка срезала бы крестики */
  .hero::before {
    top: calc(var(--header-h) + 1rem);
    right: var(--gutter);
  }

  h1 {
    font-weight: 600;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
    max-width: 12ch;
  }

  .mark {
    color: var(--accent);
  }

  .sub {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.05rem;
    color: var(--muted);
  }

  .sub strong {
    color: var(--ink);
    font-weight: 500;
  }

  /* ---------- Заголовки секций ---------- */
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .section-head h2 {
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
  }

  /* Поля равны краю окна плюс воздух — иначе рамка срезала бы низ текста */
  .work,
  .strengths,
  .experience,
  .about {
    padding-block: calc(var(--header-h) + 1rem);
  }

  /* Опыт длиннее экрана — и это нормально: спецификация требует игнорировать
     точки привязки, из-за которых контент стал бы недостижимым. Секция просто
     прокручивается целиком, а следующий экран примагничивается на её границе. */

  /* ---------- Work: ровная сетка в две колонки ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3.5vw, 2.5rem);
  }

  /* ---------- Core strengths ---------- */
  .strengths ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .strengths li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 0.5rem 2rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s ease;
  }

  /* Список не закрывается линией снизу — остаются только разделители */
  .strengths li:last-child {
    border-bottom: 0;
  }

  .strengths li:hover {
    background: color-mix(in srgb, var(--paper) 96%, var(--ink));
  }

  .strengths h3 {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.015em;
    color: #222;
  }

  .strengths p {
    font-weight: 400;
    font-size: 16px;
    color: #222;
    max-width: 46rem;
  }

  /* ---------- Experience ---------- */
  .experience > ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .experience > ol > li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 0.5rem 2rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s ease;
  }

  .experience > ol > li:last-child {
    border-bottom: 0;
  }

  .experience > ol > li:hover {
    background: color-mix(in srgb, var(--paper) 96%, var(--ink));
  }

  .experience h3 {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.015em;
    color: #222;
  }

  .experience .company {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .experience .period {
    margin-top: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  /* Пункты описания — буллетами, как в резюме. Маркер — тире. */
  .experience .points {
    margin: 0;
    padding-left: 0;
    max-width: 46rem;
    list-style: none;
  }

  .experience .points li {
    position: relative;
    padding-left: 1.4rem;
    font-weight: 400;
    font-size: 16px;
    color: #222;
  }

  /* Тире вынесено в поле, текст пункта выравнивается по одной линии */
  .experience .points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  .experience .points li + li {
    margin-top: 0.4rem;
  }

  /* ---------- About ---------- */
  /* Первый абзац — editorial-лид, крупнее и чернилами */
  .bio :global(p:first-of-type) {
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 32ch;
  }

  .bio :global(p + p) {
    margin-top: 1.1rem;
    max-width: 58ch;
    font-size: 1rem;
    color: var(--muted);
  }

  .facts {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 1.5rem;
  }

  .fact dd {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
  }

  /* ---------- Адаптив ---------- */
  @media (max-width: 56rem) {
    .strengths li,
    .experience > ol > li {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 44rem) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Активной считается работа, пересёкшая середину экрана: rootMargin сжимает
  // область наблюдения до линии по центру, поэтому активной всегда ровно одна.
  const setupBackdrop = () => {
    const layer = document.querySelector<HTMLElement>('[data-backdrop-layer]');
    if (!layer) return;

    const cases = document.querySelectorAll<HTMLElement>('.case[data-backdrop]');
    if (!cases.length) return;

    // На мобильных .scroller не прокручивается — там наблюдаем за окном.
    const scroller = document.querySelector('.scroller');
    const root =
      scroller instanceof HTMLElement && scroller.scrollHeight > scroller.clientHeight
        ? scroller
        : null;

    const active = new Set<HTMLElement>();

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting) active.add(target);
          else active.delete(target);
        }

        const current = [...active].pop();
        if (current) {
          layer.style.setProperty('--backdrop-color', current.dataset.backdrop || '');
          layer.classList.add('is-on');
        } else {
          layer.classList.remove('is-on');
        }
      },
      { root, rootMargin: '-50% 0px -50% 0px' },
    );

    cases.forEach((section) => io.observe(section));
  };

  setupBackdrop();
  document.addEventListener('astro:page-load', setupBackdrop);
</script>
