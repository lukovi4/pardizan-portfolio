---
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home/home.md не найден');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  /* Пункт, подсвеченный сразу при отрисовке. На странице кейса это всегда
     Work: страница целиком относится к работам, следить не за чем.
     На главной пункт выбирает наблюдатель в скрипте ниже. */
  active?: 'work' | 'experience' | 'about' | 'contact';
}

const { active } = Astro.props;
const current = (key: Props['active']) => (active === key ? 'true' : undefined);
---

<header class="site-header">
  <div class="shell inner">
    <div class="brand">
      <a class="wordmark" href={`${base}/#hero`}>Evgeny Lukovich</a>
      <span class="badge cap">Site in progress</span>
    </div>
    <button
      class="burger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-nav"
      data-burger
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <button class="overlay" type="button" tabindex="-1" aria-hidden="true" data-menu-overlay></button>
    <nav id="site-nav" aria-label="Main">
      <a href={`${base}/#cases`} data-nav="work" aria-current={current('work')}>Work</a>
      <a href={`${base}/#experience`} data-nav="experience" aria-current={current('experience')}>
        Experience
      </a>
      <a href={`${base}/#about`} data-nav="about" aria-current={current('about')}>About</a>
      <a href={`${base}/#contact`} data-nav="contact" aria-current={current('contact')}>Contact</a>
      <a href={home.data.links.resume} target="_blank" rel="noopener">CV</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    /* Скроллится .scroller, а не страница, поэтому шапка фиксированная */
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
  }

  /* Подложка шапки вынесена в псевдоэлемент: backdrop-filter на самой шапке
     делает её точкой отсчёта для position: fixed внутри, и шторка меню
     считала бы края не по экрану, а по строке шапки. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .wordmark {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* Пометка о том, что сайт ещё дорабатывается */
  .badge {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: var(--brand);
    /* .cap красит текст серым — на жёлтом нужен основной цвет */
    color: var(--ink);
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.35rem;
  }

  /* Кнопка меню: две линии, складывающиеся в крестик. На широких экранах
     не нужна — меню и так стоит строкой. */
  .burger {
    display: none;
    /* Над затемнением: крестик должен оставаться нажимаемым */
    position: relative;
    z-index: 25;
    width: 2.25rem;
    height: 2.25rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .burger span {
    position: absolute;
    left: 50%;
    width: 1.25rem;
    height: 2px;
    margin-left: -0.625rem;
    background: var(--ink);
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .burger span:first-child {
    top: calc(50% - 4px);
  }

  .burger span:last-child {
    top: calc(50% + 2px);
  }

  /* Открытое меню: линии сходятся в крестик */
  .site-header.is-open .burger span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .site-header.is-open .burger span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* Затемнение под шторкой. Живёт всегда, но видно его только с открытым
     меню — так переход гасится плавно, а не пропадает вместе с элементом. */
  :global(body.menu-open) {
    overflow: hidden;
  }

  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 15;
    background: rgb(0 0 0 / 0.5);
    border: 0;
    padding: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }

  .site-header.is-open .overlay {
    opacity: 1;
    visibility: visible;
  }

  /* Узкие экраны: пункты уезжают в шторку у правого края, в строке
     остаются знак сайта, пометка и кнопка. */
  @media (max-width: 56rem) {
    .burger,
    .overlay {
      display: block;
    }

    nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      width: min(20rem, 78vw);
      flex-direction: column;
      gap: 0;
      /* Сверху — место под строку шапки, чтобы первый пункт не оказался
         под знаком сайта и кнопкой */
      padding: calc(var(--header-h) + 1.25rem) var(--gutter) 2rem;
      background: var(--paper);
      /* Закрытая шторка не просто сдвинута: без visibility по ней можно
         было бы попасть табом. */
      visibility: hidden;
      transform: translateX(100%);
      transition:
        transform 0.3s ease,
        visibility 0.3s;
    }

    .site-header.is-open nav {
      visibility: visible;
      transform: none;
    }

    nav a {
      padding-block: 0.7rem;
      font-size: 0.8rem;
    }
  }

  nav a:hover,
  nav a[aria-current] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
</style>

<script>
  // Якорь на текущую страницу браузер отрабатывает только когда адрес меняется:
  // повторный клик по тому же пункту (или по знаку сайта, когда в адресе уже
  // #hero) не делал ничего. Прокручиваем сами, адрес правим вручную.
  const scrollToHash = (event: MouseEvent) => {
    // Клик с модификатором — открыть в новой вкладке, не мешаем
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const link = (event.target as Element | null)?.closest?.('a[href]');
    if (!(link instanceof HTMLAnchorElement) || link.target === '_blank') return;

    const url = new URL(link.href);
    // Только ссылки на текущую страницу: переходы на другие обрабатывает Astro
    if (url.origin !== location.origin || url.pathname !== location.pathname) return;
    if (!url.hash || url.hash === '#') return;

    const target = document.querySelector(url.hash);
    if (!target) return;

    event.preventDefault();
    // Без behavior — уважаем scroll-behavior контейнера и «уменьшить движение»
    target.scrollIntoView({ block: 'start' });
    history.pushState(null, '', url.hash);
  };

  // Перехват на этапе погружения: иначе клик успеет забрать роутер Astro
  document.addEventListener('click', scrollToHash, true);

  // Прокручивается .scroller, а не документ, поэтому переход по адресу с
  // якорем ни браузер, ни роутер довести не могут: они двигают окно, а
  // контейнер остаётся наверху. Это ломало и переход из кейса в раздел
  // главной, и прямой заход по ссылке вида /#about. Доводим сами.
  const scrollToCurrentHash = () => {
    if (!location.hash || location.hash === '#') return;
    const target = document.querySelector(location.hash);
    if (!target) return;
    // instant, а не auto: auto означает «взять значение scroll-behavior из
    // CSS», а там smooth — и открытие ссылки с якорем превращалось бы в
    // самопроизвольный отъезд страницы вниз. Здесь нужен мгновенный переход.
    // Дважды — сразу и следующей задачей: роутер сбрасывает прокрутку уже
    // после нашего обработчика, одного вызова не хватает.
    const go = () => target.scrollIntoView({ block: 'start', behavior: 'instant' });
    go();
    setTimeout(go, 0);
  };

  // Активным считается раздел, пересёкший середину экрана: rootMargin сжимает
  // область наблюдения до линии по центру, поэтому активным всегда ровно один.
  // Тот же приём, что у подложки под работами на главной.
  const setupNavSpy = () => {
    const links = new Map<string, HTMLAnchorElement>();
    document
      .querySelectorAll<HTMLAnchorElement>('nav a[data-nav]')
      .forEach((link) => links.set(link.dataset.nav ?? '', link));
    if (!links.size) return;

    // Следим только на главной: на странице кейса пункт проставлен на сервере
    // и не должен меняться, хотя блок контактов там тоже есть.
    if (!document.getElementById('hero')) return;

    const sections: Array<[HTMLElement, string]> = [];
    document
      .querySelectorAll<HTMLElement>('.case')
      .forEach((section) => sections.push([section, 'work']));
    for (const key of ['experience', 'about', 'contact']) {
      const section = document.getElementById(key);
      if (section) sections.push([section, key]);
    }
    if (!sections.length) return;

    const keyOf = new Map(sections);
    // Прокручивается .scroller, а не окно, — наблюдаем за ним
    const scroller = document.querySelector('.scroller');
    const root =
      scroller instanceof HTMLElement && scroller.scrollHeight > scroller.clientHeight
        ? scroller
        : null;

    const active = new Set<HTMLElement>();

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting) active.add(target);
          else active.delete(target);
        }

        // В hero не подсвечен никто: у него нет своего пункта меню
        const key = active.size ? keyOf.get([...active].pop()!) : undefined;
        for (const [name, link] of links) {
          if (name === key) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      },
      { root, rootMargin: '-50% 0px -50% 0px' },
    );

    sections.forEach(([section]) => io.observe(section));
  };

  // Меню под кнопкой на узких экранах. Состояние живёт классом на шапке:
  // и стили, и разметка читают одно и то же.
  // Меню под кнопкой на узких экранах. Состояние живёт классом на шапке:
  // и стили, и разметка читают одно и то же. Шапку ищем на каждом вызове —
  // после перехода между страницами элемент новый, а слушатели ниже общие.
  const setMenu = (open: boolean) => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    header.classList.toggle('is-open', open);
    header.querySelector('[data-burger]')?.setAttribute('aria-expanded', String(open));
    // Под открытой шторкой страница не прокручивается
    document.body.classList.toggle('menu-open', open);
  };

  const setupBurger = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
    if (!header || !burger || header.dataset.burgerReady) return;
    header.dataset.burgerReady = '1';

    burger.addEventListener('click', () => setMenu(!header.classList.contains('is-open')));

    // Клик по пункту уводит на раздел — меню закрывается само
    header
      .querySelectorAll('nav a')
      .forEach((link) => link.addEventListener('click', () => setMenu(false)));

    header.querySelector('[data-menu-overlay]')?.addEventListener('click', () => setMenu(false));
  };

  // Клик мимо шапки, Escape и возврат к широкому окну закрывают меню.
  // Вешаются один раз на весь сеанс: элементы шапки они ищут сами.
  document.addEventListener('click', (event) => {
    const header = document.querySelector('.site-header');
    if (header && !header.contains(event.target as Node)) setMenu(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  matchMedia('(min-width: 56.01rem)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });

  const setup = () => {
    scrollToCurrentHash();
    setupNavSpy();
    setupBurger();
  };

  setup();
  document.addEventListener('astro:page-load', setup);
  // Смена только якоря — это не загрузка страницы: ни astro:page-load, ни
  // прокрутка браузера не сработают, потому что двигать надо .scroller.
  // Сюда попадают «назад/вперёд» и правка адреса руками.
  window.addEventListener('hashchange', scrollToCurrentHash);
</script>
