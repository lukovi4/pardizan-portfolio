---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, slug, summary, roles, years, role, links } = project.data;

// Поля карточки: подпись слева, значение справа
// Scope у некоторых работ занимает семь строк — на невысоком окне он
// обрезается, остальные поля показываются целиком.
const fields = [
  years && { label: 'Years', value: years },
  role && { label: 'Role', value: role },
  roles?.length && { label: 'Scope', value: roles.join(', '), long: true },
].filter(Boolean) as { label: string; value: string; long?: boolean }[];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="info">
  <h3>{name}</h3>
  {summary && <p class="summary">{summary}</p>}

  <dl class="fields">
    {
      fields.map((field) => (
        <div class:list={['field', field.long && 'long']}>
          <dt>{field.label}</dt>
          <dd>{field.value}</dd>
        </div>
      ))
    }
    {
      links?.length && (
        <div class="field">
          <dt>Media</dt>
          <dd class="links">
            {links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </dd>
        </div>
      )
    }
  </dl>

  <a class="cta" href={`${base}/${slug}`}>
    <span class="label">See case</span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .info {
    /* Ширину и высоту карточки задаёт родительский кейс. */
    position: relative;
    width: var(--info-w);
    height: var(--cell-h);
    display: flex;
    flex-direction: column;
    padding: var(--card-pad, 40px);
    /* Карточка белая: под работами лежит цветная подложка, и белое поле
       описания отделяется от неё само. */
    background: var(--paper);
    border-radius: 14px;
  }

  h3 {
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  /* Высота карточки задана лентой, а описание у работ разной длины. На
     невысоком окне текст не помещался и вываливался за карточку, поэтому
     он обрезается: сколько влезло — столько показано, остальное читается
     на странице кейса. Число строк задано ступенями по высоте окна ниже.
     Сжатие флексом — страховка на случай, когда даже это не спасает:
     переполниться карточка не должна ни при каких размерах. */
  .summary {
    margin-top: 0.7rem;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
    flex: 0 1 auto;
    min-height: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--summary-lines, 999);
    overflow: hidden;
  }

  /* Ступени подобраны по самой длинной работе: на каждой высоте описание и
     поля кончаются раньше, чем кончается место под ними. */
  @media (max-height: 900px) {
    .info {
      --summary-lines: 8;
      --field-lines: 3;
    }
  }

  @media (max-height: 820px) {
    .info {
      --summary-lines: 6;
    }
  }

  @media (max-height: 740px) {
    .info {
      --summary-lines: 4;
      --field-lines: 2;
    }
  }

  @media (max-height: 660px) {
    .info {
      --summary-lines: 3;
      --field-lines: 1;
      --card-pad: 28px;
    }
  }

  @media (max-height: 580px) {
    .info {
      --summary-lines: 2;
      --card-pad: 24px;
    }
  }

  /* Поля кейса: слева подпись, справа значение. Список сжимается вместе с
     описанием: у работ вроде Lastik один только Scope занимает семь строк,
     и на невысоком окне поля выталкивали кнопку за карточку. */
  .fields {
    margin: 1.75rem 0 0;
    flex: 0 1 auto;
    min-height: 0;
    overflow: hidden;
  }

  .field {
    display: grid;
    grid-template-columns: minmax(0, 5rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
  }

  dt {
    font-size: 0.85rem;
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: 0.9rem;
    color: #222;
  }

  /* Длинное поле обрезается по строкам, как и описание. Короткие — Years,
     Role — показываются целиком: обрезать в них нечего. */
  .field.long dd {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--field-lines, 999);
    overflow: hidden;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .links a {
    /* Над растянутой ссылкой на кейс — иначе клик по ним уводил бы на неё */
    position: relative;
    z-index: 1;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .links a:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }

  /* Ссылка на кейс прижата к низу карточки. В покое видна одна стрелка у
     левого края; при наведении на карточку слева проявляется подпись и
     отодвигает стрелку ровно на свою ширину. Фона у ссылки нет.
     Колонка подписи раскрывается от 0fr к 1fr: в отличие от width: auto
     это анимируется, а ширина по содержимому получается сама — потому и
     сетка, а не флексбокс. fit-content нужен, чтобы 1fr считался по тексту,
     а не растягивался во всю карточку. */
  .cta {
    margin-top: auto;
    width: fit-content;
    display: grid;
    grid-template-columns: 0fr auto;
    /* Зазор до стрелки раскрывается вместе с подписью: держи его
       постоянным — и в покое стрелка стояла бы в 20px от края. */
    column-gap: 0;
    align-items: center;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink);
    /* Кривая с длинным выбегом: движение начинается быстро и почти
       останавливается к концу — стрелка мягко доезжает до места. */
    transition:
      grid-template-columns 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      column-gap 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .info:hover .cta,
  .cta:focus-visible {
    grid-template-columns: 1fr auto;
    column-gap: 20px;
  }

  /* Кликается вся карточка: псевдоэлемент растягивает ссылку на её площадь.
     Так в разметке не появляется ссылок внутри ссылки — Media-ссылки выше
     остаются самостоятельными. */
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Подпись живёт в потоке всегда — иначе её не прочитает скринридер.
     В покое колонка сжата в ноль, и подпись обрезается целиком: без
     min-width: 0 сетка не дала бы ей стать уже своего текста. */
  .label {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .info:hover .label,
  .cta:focus-visible .label {
    opacity: 1;
  }

  /* Телефон и планшет: ленты рядом нет, карточка занимает всю ширину
     колонки и растёт по тексту — обрезать описание незачем. */
  @media (max-width: 56rem) {
    .info {
      width: 100%;
      /* На планшете строка во всю ширину была бы слишком длинной для
         чтения — мера та же, что у текста на странице кейса. */
      max-width: 40rem;
      height: auto;
      padding: 0;
      /* Ступени по высоте окна ниже сюда не относятся: место под текст
         здесь ничем не ограничено, обрезать нечего. */
      --summary-lines: 999;
      --field-lines: 999;
    }

    /* Наводить нечем и незачем: подпись стоит раскрытой сразу */
    .cta {
      margin-top: 1.75rem;
      grid-template-columns: 1fr auto;
      column-gap: 20px;
    }

    .label {
      opacity: 1;
    }
  }

  /* Без мыши наведения не бывает — там подпись видна сразу */
  @media (hover: none) {
    .cta {
      grid-template-columns: 1fr auto;
      column-gap: 20px;
    }

    .label {
      opacity: 1;
    }
  }
</style>
