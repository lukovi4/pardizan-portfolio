---
import { Image } from 'astro:assets';

interface Props {
  screens: { src: ImageMetadata; alt: string }[];
  /** Резервирует слева место под неподвижную карточку описания (главная) */
  lead?: boolean;
}

const { screens, lead = false } = Astro.props;

// Ширина ячейки — из пропорций первого скрина: мобильные встают узкими
// колонками, десктопные — широкими. Запасное значение — пропорции iPhone.
const first = screens[0];
const ratio = first ? first.src.width / first.src.height : 780 / 1688;

// Ширина ячейки считается от высоты экрана (максимум 900px, на мобильных 560),
// а не от ширины окна — поэтому sizes задаём в пикселях, иначе браузер берёт
// вариант «на глазок». Горизонтальным работам нужны варианты крупнее: они
// занимают почти всю ширину подложки, а не узкую колонку телефона.
const wide = ratio > 1;
const widths = wide ? [800, 1600, 2400, 3200] : [300, 600, 900];
const sizes = `(max-width: 56rem) ${Math.round(560 * ratio)}px, ${Math.round(900 * ratio)}px`;
---

{/*
  Единственное место, где живёт поведение ленты: прокрутка трекпадом, свайп и
  перетаскивание мышью. Родитель управляет ей через переменные:
    --cell-h      высота ячейки (обязательна)
    --strip-tail  хвост справа в конце прокрутки (по умолчанию 40px)
    --strip-bleed отрицательный отступ справа, чтобы лента уходила за край
    --info-w      ширина карточки описания — нужна только при lead
*/}
<div class:list={['strip', lead && 'has-lead']} style={`--cell-ratio: ${ratio}`} data-strip>
  <ul>
    {
      screens.map((screen) => (
        <li>
          <Image
            src={screen.src}
            alt={screen.alt}
            widths={widths}
            sizes={sizes}
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .strip {
    --cell-w: calc(var(--cell-h) * var(--cell-ratio));
    /* Зазор пропорционален ячейке — иначе на большом мониторе скрины
       высотой 900px стоят с тем же просветом, что и 540px на ноутбуке.
       0.045 подобрано так, чтобы на ноутбуке остались привычные ~24px. */
    --cell-gap: clamp(16px, calc(var(--cell-h) * 0.045), 48px);

    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* Диагональный свайп не должен уводить вертикальную прокрутку страницы */
    touch-action: pan-y;
    /* Лента может выходить за правый край секции — скрины срезает край экрана */
    margin-right: var(--strip-bleed, 0px);
    cursor: grab;
    /* Полосу прокрутки прячем — лента листается жестом, а не скроллбаром */
    scrollbar-width: none;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  /* Во время перетаскивания курсор держит «схваченное» состояние,
     а текст и картинки не выделяются. */
  .strip.dragging {
    cursor: grabbing;
    user-select: none;
  }

  .strip ul {
    display: flex;
    width: max-content;
    gap: var(--cell-gap);
    margin: 0;
    /* Справа — хвост, чтобы в конце прокрутки последний скрин отступал от края */
    padding: 0 var(--strip-tail, 40px) 0 0;
    list-style: none;
  }

  /* Слева — место под неподвижную карточку описания */
  .strip.has-lead ul {
    padding-left: calc(var(--info-w) + var(--cell-gap));
  }

  .strip li {
    flex: none;
  }

  .strip img {
    width: var(--cell-w);
    height: var(--cell-h);
    border-radius: 14px;
    /* Пропорции скрина совпадают с ячейкой — обрезки не будет */
    object-fit: cover;
    background: #fff;
    /* Иначе браузер начинает своё перетаскивание картинки */
    -webkit-user-drag: none;
    user-select: none;
    /* Скрин открывается в галерее */
    cursor: zoom-in;
  }

  /* Мобильная версия делается отдельно — там зазор пока прежний */
  @media (max-width: 56rem) {
    .strip {
      --cell-gap: 16px;
    }
  }
</style>

<script>
  const setupStrips = () => {
    document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
      if (strip.dataset.dragReady) return;
      strip.dataset.dragReady = '1';

      let pointerId: number | null = null;
      let startX = 0;
      let startLeft = 0;
      let moved = false;

      strip.addEventListener('pointerdown', (event) => {
        // Тач и перо листают лентой сами — перехватываем только мышь.
        if (event.pointerType !== 'mouse') return;
        pointerId = event.pointerId;
        startX = event.clientX;
        startLeft = strip.scrollLeft;
        moved = false;
      });

      strip.addEventListener('pointermove', (event) => {
        if (pointerId === null || event.pointerId !== pointerId) return;
        const shift = event.clientX - startX;
        // Захват начинается только после заметного движения, иначе обычный
        // клик по кнопке внутри ленты не доходил бы до ссылки.
        if (!moved && Math.abs(shift) < 4) return;
        if (!moved) {
          moved = true;
          strip.classList.add('dragging');
          strip.setPointerCapture(event.pointerId);
        }
        strip.scrollLeft = startLeft - shift;
      });

      const stop = (event: PointerEvent) => {
        if (pointerId === null || event.pointerId !== pointerId) return;
        if (strip.hasPointerCapture(event.pointerId)) strip.releasePointerCapture(event.pointerId);
        strip.classList.remove('dragging');
        pointerId = null;
      };

      strip.addEventListener('pointerup', stop);
      strip.addEventListener('pointercancel', stop);

      // Перетаскивание не должно срабатывать как клик по ссылке.
      strip.addEventListener(
        'click',
        (event) => {
          if (!moved) return;
          event.preventDefault();
          event.stopPropagation();
          moved = false;
        },
        true,
      );
    });
  };

  setupStrips();
  document.addEventListener('astro:page-load', setupStrips);
</script>
