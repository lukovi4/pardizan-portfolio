---
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
if (!home) throw new Error('src/content/home/home.md не найден');

const { email, telegram, linkedin, resume } = home.data.links;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <h2 data-reveal>Have a product to ship<span class="mark">?</span></h2>
    <div class="actions" data-reveal>
      <a class="btn" href={`mailto:${email}`}>{email}</a>
      <nav aria-label="Social">
        <a href={telegram} target="_blank" rel="noopener">Telegram ↗</a>
        <a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={resume} target="_blank" rel="noopener">CV ↗</a>
      </nav>
    </div>
    <div class="fine">
      <span>© {year} Evgeny Lukovich · Warsaw, Poland</span>
      <span>pardizan.com</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 8vw, 5.5rem) 2rem;
    /* Последний экран: короче окна, поэтому примагничивается низом */
    scroll-snap-align: end;
  }

  h2 {
    font-weight: 600;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .mark {
    color: var(--accent);
  }

  .actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent-ink);
  }

  .fine {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
</style>
