---
import type { CollectionEntry } from 'astro:content';
import CaseInfo from './CaseInfo.astro';
import ScreenStrip from './ScreenStrip.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Якорь для меню — ставится только первому кейсу */
  anchor?: string;
}

const { project, anchor } = Astro.props;
const { screens = [], backdrop } = project.data;
---

<section id={anchor} class="case screen" data-backdrop={backdrop}>
  <!-- Лента листается трекпадом, свайпом и перетаскиванием мыши.
       Описание лежит отдельным слоем: скрины проходят под ним, а слева от
       карточки не появляются — лента начинается ровно от её левого края. -->
  <div class="case-body">
    <div class="pin">
      <CaseInfo project={project} />
    </div>
    <ScreenStrip screens={screens} lead />
  </div>
</section>

<style>
  .case {
    display: grid;
    /* minmax(0, 1fr) обязателен: иначе grid-элемент не сжимается уже своего
       содержимого, лента растягивается во всю длину и толкает страницу вбок. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;

    /* Работа целиком вписана в подложку. Слева поле равно верхнему и
       нижнему: те получаются как половина остатка подложки после ячейки,
       поэтому на высоком экране растут — и левое растёт вместе с ними.
       max нужен, чтобы не получить отрицательный padding: он недопустим,
       и браузер выбросил бы всё правило целиком.
       Справа поля нет — лента доходит до края подложки и обрезается им. */
    --case-pad: max(
      0px,
      calc((100dvh - 2 * var(--header-h) - var(--cell-h)) / 2)
    );
    padding-block: var(--header-h);
    padding-inline: calc(var(--panel-inset) + var(--case-pad)) var(--panel-inset);

    /* Высота ячейки = внутренняя высота подложки. Верхняя граница нужна,
       чтобы на очень высоких экранах кейс не разъезжался. */
    --cell-h: clamp(
      280px,
      calc(100dvh - 2 * var(--header-h) - 2 * var(--panel-pad)),
      900px
    );
    /* Ширина карточки описания — полторы ячейки мобильного скрина, но
       в заданных границах: на низком окне не сплющивается, на высоком
       не разъезжается. Границы меняются здесь. */
    --info-min: 320px;
    --info-max: 480px;
    --info-w: clamp(
      var(--info-min),
      calc(var(--cell-h) * 780 / 1688 * 1.5),
      var(--info-max)
    );
    /* Зазор пропорционален ячейке — иначе на большом мониторе скрины
       высотой 900px стоят с тем же просветом, что и 540px на ноутбуке.
       0.045 подобрано так, чтобы на ноутбуке остались привычные ~24px.
       Задан здесь, а не в ленте: тем же зазором разделены карточка и лента. */
    --cell-gap: clamp(16px, calc(var(--cell-h) * 0.045), 48px);
    /* Лента упирается в правый край подложки, хвост в конце прокрутки —
       её внутреннее поле */
    --strip-bleed: 0px;
    --strip-tail: var(--panel-pad);
  }

  /* Без постраничности подложки нет — работы живут по обычным полям страницы.
     Лента скринов здесь не показывается: на телефоне она начиналась за правым
     краем карточки, и от работы была видна полоска в несколько пикселей.
     Осталось описание во всю ширину — скрины смотрят на странице кейса. */
  @media (max-width: 56rem) {
    .case {
      padding-block: 2rem;
      padding-inline: var(--gutter);
    }

    .case :global(.strip) {
      display: none;
    }
  }

  .case-body {
    position: relative;
    /* Запрет на раздувание: иначе лента растягивается во всю длину */
    min-width: 0;
  }

  /* Описание вынуто из потока прокрутки: не sticky, а неподвижный слой,
     поэтому при перетаскивании ленты оно не дрожит. Левый край совпадает
     с левым краем ленты — слева от карточки скринам взяться неоткуда. */
  .pin {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
  }

  /* Ленты под карточкой больше нет — описание возвращается в поток.
     Правило стоит после основного: медиа-запрос не добавляет веса, и выше
     по файлу его перебило бы absolute. */
  @media (max-width: 56rem) {
    .pin {
      position: static;
    }
  }
</style>
