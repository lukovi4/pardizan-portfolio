---
import type { CollectionEntry } from 'astro:content';
import CaseInfo from './CaseInfo.astro';
import ScreenStrip from './ScreenStrip.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Якорь для меню — ставится только первому кейсу */
  anchor?: string;
}

const { project, anchor } = Astro.props;
const { screens = [] } = project.data;
---

<section id={anchor} class="case screen">
  <!-- Лента листается трекпадом, свайпом и перетаскиванием мыши.
       Описание лежит отдельным слоем — оно не участвует в прокрутке. -->
  <div class="case-body">
    <div class="pin">
      <CaseInfo project={project} />
    </div>
    <ScreenStrip screens={screens} lead />
  </div>
</section>

<style>
  .case {
    display: grid;
    /* minmax(0, 1fr) обязателен: иначе grid-элемент не сжимается уже своего
       содержимого, лента растягивается во всю длину и толкает страницу вбок. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    /* Без ограничения по ширине: кейс занимает экран, только 40px по краям */
    padding-inline: 40px;

    /* Высота ячеек резиновая: занимает весь экран за вычетом шапки и полей
       секции, поэтому на высоком мониторе скрины крупнее. Верхняя граница
       нужна, чтобы на очень высоких экранах кейс не разъезжался. */
    --chrome-h: calc(var(--header-h) + 1.5rem + 2.5rem);
    --cell-h: clamp(320px, calc(100dvh - var(--chrome-h)), 900px);
    /* Ширина карточки описания — полторы ячейки мобильного скрина */
    --info-w: calc(var(--cell-h) * 780 / 1688 * 1.5);
    /* Лента выходит за правый отступ секции — скрины срезает край экрана */
    --strip-bleed: -40px;
  }

  .case-body {
    position: relative;
    /* Запрет на раздувание: иначе лента растягивается во всю длину */
    min-width: 0;
  }

  /* Описание вынуто из потока прокрутки: не sticky, а неподвижный слой,
     поэтому при перетаскивании ленты оно не дрожит. */
  .pin {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
  }
</style>
